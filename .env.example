# Auth de la app (HTTP Basic)
APP_USERNAME=admin
APP_PASSWORD=cambia-esto

# Odoo connection (JSON-RPC)
ODOO_URL=https://tu-instancia.odoo.com
ODOO_DB=nombre-database
ODOO_LOGIN=usuario@dominio.com
ODOO_API_KEY=tu-api-key

# Casa del Libro scraper
PROXY_URL=
BULK_POOL_SIZE=6
PAGES_PER_ROUND=200
SKIP_DISCOVERY_IF_OVER=500

# Postgres (REQUERIDO para deploy multi-server. Sin esto usa SQLite local
# y los dos servers NO comparten la cola.)
DATABASE_URL=

# Multi-server: identifica este servidor en la cola para debug/telemetria.
# La garantia de no-duplicacion la da Postgres FOR UPDATE SKIP LOCKED.
# Pon "A" en uno y "B" en el otro (o nombres descriptivos).
WORKER_NAME=A

# Enrichment tuning
ENRICH_QUEUE_REFILL_AT=500
ENRICH_QUEUE_REFILL_SIZE=2000
ENRICH_PUSH_BATCH=50
ENRICH_PUSH_INTERVAL_S=30
ENRICH_MAX_ATTEMPTS=1
ENRICH_FALLBACK_SEARCH=0

# Telegram notifications (opcional pero recomendado para monitor mobile)
# 1. Habla con @BotFather → /newbot → guarda el token
# 2. Habla con @userinfobot → guarda tu chat_id
# 3. Manda /start a tu bot UNA VEZ para autorizar mensajes
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_INTERVAL_MIN=60
NOTIFY_BAN_NOTFOUND_PCT=0.85
