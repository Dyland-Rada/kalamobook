# Auth de la app (HTTP Basic)
APP_USERNAME=admin
APP_PASSWORD=cambia-esto

# Odoo connection (JSON-RPC)
ODOO_URL=https://tu-instancia.odoo.com
ODOO_DB=nombre-database
ODOO_LOGIN=usuario@dominio.com
ODOO_API_KEY=tu-api-key

# Casa del Libro scraper
PROXY_URL=
# Pool de proxies (lista separada por comas). Si esta seteado, sobreescribe
# PROXY_URL: arranca un browser por proxy y distribuye POOL_SIZE paginas.
# Cada entrada acepta formato:
#   - host:port:user:pass            (Webshare export)
#   - http://user:pass@host:port     (formato URL)
#   - host:port                      (sin auth)
# Ej. con Webshare free tier (10 IPs):
#   PROXY_POOL=38.154.203.95:5863:dbmtsefb:v2u0o3v5g883,198.105.121.200:6462:dbmtsefb:v2u0o3v5g883,...
PROXY_POOL=
BULK_POOL_SIZE=6
PAGES_PER_ROUND=200
SKIP_DISCOVERY_IF_OVER=500

# Postgres (REQUERIDO para deploy multi-server. Sin esto usa SQLite local
# y los dos servers NO comparten la cola.)
DATABASE_URL=

# Multi-server: identifica este servidor en la cola para debug/telemetria.
# La garantia de no-duplicacion la da Postgres FOR UPDATE SKIP LOCKED.
# Pon "A" en uno y "B" en el otro (o nombres descriptivos).
WORKER_NAME=A

# Enrichment tuning
ENRICH_QUEUE_REFILL_AT=500
ENRICH_QUEUE_REFILL_SIZE=2000
ENRICH_PUSH_BATCH=50
ENRICH_PUSH_INTERVAL_S=30
ENRICH_MAX_ATTEMPTS=1
ENRICH_FALLBACK_SEARCH=0
# Delay entre requests por worker (s). Subir si CDL throttlea (timeouts masivos).
ENRICH_WORKER_DELAY_MIN=1.5
ENRICH_WORKER_DELAY_MAX=3.5

# Google Books API como cascada cuando CDL no tiene el libro.
# Gratis hasta 1000 req/dia sin key, 100k/dia con key (https://console.cloud.google.com)
# Si lo dejas vacio, igual funciona pero quedas en el limite gratis sin key.
GOOGLE_BOOKS_API_KEY=
# Activa el fallback a Google Books cuando CDL no encuentra el libro. Default ON.
ENRICH_GBOOKS_FALLBACK=1
# Cuando CDL si trae el libro pero le falta description, completar con Google Books.
# Cuesta 1 API call extra por libro CDL. Default OFF — activar si te importa
# mas la cobertura que la velocidad.
ENRICH_GBOOKS_ENRICH_CDL=0

# Telegram notifications (opcional pero recomendado para monitor mobile)
# 1. Habla con @BotFather → /newbot → guarda el token
# 2. Habla con @userinfobot → guarda tu chat_id
# 3. Manda /start a tu bot UNA VEZ para autorizar mensajes
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_INTERVAL_MIN=60
NOTIFY_BAN_NOTFOUND_PCT=0.85
# Para responder /status desde Telegram. Setealo solo en el server que sea
# el target del webhook (Telegram solo soporta una URL por bot). Si lo dejas
# vacio, cualquier request al webhook es aceptado pero igual se verifica
# el chat_id. Recomendado: pon un string aleatorio largo en AMBOS.
TELEGRAM_WEBHOOK_SECRET=
